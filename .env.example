# Copy to .env next to the nugs_dl binary and fill in. Keep it private (chmod 600 .env).
# Variables set in the environment take precedence over this file.

# Email and password for a regular nugs.net account.
NUGS_EMAIL=
NUGS_PASSWORD=

# Or a token for Apple and Google accounts (see token.md). Used instead of the
# email and password when set.
NUGS_TOKEN=
